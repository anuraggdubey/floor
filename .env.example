# Copy to .env and fill in. NEVER commit .env. Testnet only.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org   # or another provider from https://docs.near.org/api/rpc/providers

# Deployed contracts
FUSDC_CONTRACT=
POOL_CONTRACT=
FLOOR_CONTRACT=
SIGNER_CONTRACT=v1.signer-prod.testnet

# Role accounts and ed25519 secret keys (testnet only)
ADMIN_ACCOUNT=
ADMIN_KEY=
KEEPER_ACCOUNT=
KEEPER_KEY=
ARB_ACCOUNT=
ARB_KEY=
SOLVER_A_ACCOUNT=
SOLVER_A_KEY=
SOLVER_A_QUOTE_SEED=          # 32-byte hex ed25519 seed that signs this solver's quotes
SOLVER_B_ACCOUNT=
SOLVER_B_KEY=
SOLVER_B_QUOTE_SEED=
SOLVER_C_ACCOUNT=
SOLVER_C_KEY=
SOLVER_C_QUOTE_SEED=
GUEST_PARENT=
GUEST_PARENT_KEY=
FLOOR_KEY=
FUSDC_KEY=
POOL_KEY=
ENC_SECRET=                   # random hex; encrypts guest keys at rest

# F3 (Chain Signatures payout on an EVM testnet): only needed if the spike passes
EVM_CHAIN_NAME=
EVM_RPC_URL=
EVM_USDC_ADDRESS=             # from Circle docs, do not guess
EVM_DERIVATION_PATH=floor-pool-1

# Optional
ONECLICK_API_KEY=             # server only; Intents dry quotes
DRY_RUN=0
PAYOUT_CAP_USDC=5
PAYOUT_DAILY_CAP_USDC=50
