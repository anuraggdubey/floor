# Copy to .env and fill in. NEVER commit .env. Testnet only.
NEAR_NETWORK=testnet
NEAR_RPC_URL=                 # pick a current testnet RPC from https://docs.near.org/api/rpc/providers

# Contract accounts (you create these; see docs/SETUP.md)
FUSDC_CONTRACT=
POOL_CONTRACT=
FLOOR_CONTRACT=
SIGNER_CONTRACT=v1.signer-prod.testnet   # confirm in current docs before relying on it

# Role accounts and keys (ed25519 secret keys, testnet only)
KEEPER_ACCOUNT=
KEEPER_KEY=
ARB_ACCOUNT=
ARB_KEY=
SOLVER_A_ACCOUNT=
SOLVER_A_KEY=
SOLVER_B_ACCOUNT=
SOLVER_B_KEY=
SOLVER_C_ACCOUNT=
SOLVER_C_KEY=
GUEST_PARENT=
GUEST_PARENT_KEY=
ENC_SECRET=                   # random string; encrypts guest keys at rest

# F3 (Chain Signatures payout): only needed if the spike passes
EVM_CHAIN_NAME=
EVM_RPC_URL=
EVM_USDC_ADDRESS=             # from Circle docs, do not guess
EVM_DERIVATION_PATH=floor-pool-1

# Optional
ONECLICK_API_KEY=             # server only; Intents dry quotes
DRY_RUN=0
PAYOUT_CAP_USDC=5
PAYOUT_DAILY_CAP_USDC=50
