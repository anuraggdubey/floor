# Copy to .env and fill in. NEVER commit .env. Testnet only.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Optional, comma separated: extra NEAR RPC endpoints, tried before the built-in fallbacks (FastNEAR, drpc, archival).
# A keyed FastNEAR URL here is the best fix for rate limits (get a free key at https://fastnear.com).
NEAR_RPC_URLS=

# Deployed contracts
FUSDC_CONTRACT=
POOL_CONTRACT=
FLOOR_CONTRACT=
SIGNER_CONTRACT=v1.signer-prod.testnet

# Role accounts and ed25519 secret keys (testnet only)
ADMIN_ACCOUNT=
ADMIN_KEY=
KEEPER_ACCOUNT=
KEEPER_KEY=
ARB_ACCOUNT=
ARB_KEY=
SOLVER_A_ACCOUNT=
SOLVER_A_KEY=
SOLVER_A_QUOTE_SEED=          # 32-byte hex ed25519 seed that signs this solver's quotes
SOLVER_B_ACCOUNT=
SOLVER_B_KEY=
SOLVER_B_QUOTE_SEED=
SOLVER_C_ACCOUNT=
SOLVER_C_KEY=
SOLVER_C_QUOTE_SEED=
GUEST_PARENT=
GUEST_PARENT_KEY=
FLOOR_KEY=
FUSDC_KEY=
POOL_KEY=
ENC_SECRET=                   # random hex; encrypts guest keys at rest


# Optional
ONECLICK_API_KEY=             # server only; Intents dry quotes
DRY_RUN=0
PAYOUT_CAP_USDC=5
PAYOUT_DAILY_CAP_USDC=50

# Cross-chain payout leg (NEAR Chain Signatures -> Ethereum Sepolia). Leave EVM_RPC_URL empty to turn it off.
EVM_RPC_URL=
# The address the Floor contract controls. Print it with: pnpm --filter @floor/worker derive-address
EVM_POOL_ADDRESS=
EVM_EXPLORER=https://sepolia.etherscan.io

# Optional: AI underwriters (Groq, OpenAI-compatible). Without a key the solvers are scripted and labelled so.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Hosted deployment
# Worker (Render): CORS origin of the deployed web app, e.g. https://floor.vercel.app. Default * is fine for a demo.
WEB_ORIGIN=
# Web (Vercel): the deployed worker URL so the browser talks to it directly, e.g. https://floor-worker.onrender.com
NEXT_PUBLIC_API_URL=
